VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_VAPID_PUBLIC_KEY=your-web-push-public-key
VITE_RELEASE_CHANNEL=beta
VITE_RELEASE_VERSION=5A
# Browser-safe values only. Use beta client values through Codespaces secrets
# or an ignored .env.local. Never put privileged/private credentials here.

# UI only; server activation/mail flags remain separate and default off.
VITE_ACCOUNT_MANAGEMENT_ENABLED=false

# Disabled source-only contract review UI; server configuration requires separate approval.
VITE_CONTRACT_NOTICE_ENABLED=false
